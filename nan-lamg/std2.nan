struct List<T> {
	T `value;
	u64 length;

	This&(T `n, u64 l) @gen 
		-- value(n)
		-- length(l)
		{} 

	T& operator at(u64 idx) @list_getter {
		ret value+(idx*sizeof(T));
	}

	void upsize() {
		T` new_value = new<T>(length+1);
		memmove<T>(new_value, value);
		free<T>(value);
		value = new_value;
		++length;
	}

	void push(T& e) {
		upsize();
		value[length-1] = e; // copy to chunk
	}
};

